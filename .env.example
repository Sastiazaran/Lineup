# The Odds API — https://the-odds-api.com/#get-access (free 500 credits/month; Lineup fetches once daily)
ODDS_API_KEY=

# Neon Postgres connection string
DATABASE_URL=

# Resend — https://resend.com (use onboarding@resend.dev until you verify your own domain)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Signed session + unsubscribe tokens (32+ random characters)
SESSION_SECRET=

# Vercel Cron: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
